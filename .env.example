# Orion web app settings.
# For local development copy this to .env; on Netlify set the same names under Site configuration -> Environment variables.
# These values are public (they ship in the browser bundle). Never put secret keys here.

# Required
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Your brands, as JSON. Default: one brand called "default".
VITE_ORION_BRANDS=[{"key":"default","label":"Your Business"}]

# The business shown on proposals, contracts and invoices
VITE_COMPANY_NAME=
VITE_COMPANY_EMAIL=
VITE_COMPANY_PHONE=
VITE_COMPANY_WEBSITE=

# Optional
# Orion's public address; defaults to the address the page is served from
VITE_APP_BASE_URL=
# Where the booking widget script is hosted, if not on this site
VITE_BOOKING_WIDGET_URL=
# Comma-separated emails allowed to see the Payments module
VITE_PAYMENTS_ALLOWED_EMAILS=
# Sales pipeline that new website leads land in
VITE_LEAD_PIPELINE_ID=
