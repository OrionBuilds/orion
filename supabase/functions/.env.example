# Orion edge function secrets
#
# Copy to supabase/functions/.env, fill in what you use, then upload:
#   npx supabase secrets set --env-file supabase/functions/.env
# Never commit the filled-in .env file.
#
# Supabase provides SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY to every
# function automatically. Don't set those here.

# ─── Required ─────────────────────────────────────────────────────────────────────────────
# Same value as the Vault secret `cron_secret` (docs/SETUP.md step 3).
CRON_SECRET=
# Your Orion web address, e.g. https://os.yourbusiness.com
APP_BASE_URL=
APP_URL=
# Your business
BUSINESS_NAME=
BUSINESS_DOMAIN=
BUSINESS_INFO_EMAIL=
BUSINESS_PHONE=
# Brands, as JSON. Default: one brand called "default".
#   [{"key":"default","label":"Your Business","siteUrl":"https://yourbusiness.com","legalName":"Your Business LLC"}]
ORION_BRANDS=
# Email (Resend). For several sending domains add RESEND_API_KEY__<DOMAIN>, e.g. RESEND_API_KEY__YOURBUSINESS_COM
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
RESEND_WEBHOOK_SECRET=
# Long random strings (openssl rand -hex 32)
CLIENT_PORTAL_INVITE_HMAC_SECRET=
APPROVAL_MAGIC_LINK_SECRET=
WEBHOOK_SECRET=

# ─── Owner and notifications ──────────────────────────────────────────────────────────────
OWNER_USER_ID=
OWNER_NAME=
OWNER_FIRST_NAME=
OWNER_ALERT_EMAIL=
OWNER_CC_EMAIL=
OWNER_PHONE=
OWNER_PERSONAL_PHONE=
OWNER_WORK_PHONE=
# Comma-separated E.164 numbers allowed to text the OS as the owner
OWNER_PHONES=
OWNER_SMS_MODE=
NOTIFY_INFO_EMAIL=
NOTIFY_ADMIN_EMAIL=
NOTIFY_ACCOUNTING_EMAIL=
SUPPORT_TEAM_EMAIL=
PAYMENTS_ALLOWED_EMAILS=

# ─── AI models ────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Embeddings for knowledge search
VOYAGE_API_KEY=

# ─── Agents ───────────────────────────────────────────────────────────────────────────────
# Clara: her Orion user id, where her service runs, and lead/booking defaults
CLARA_USER_ID=
CLARA_URL=
CLARA_LEAD_PIPELINE_ID=
CLARA_LEAD_STAGE_ID=
CLARA_LEAD_OWNER_ID=
CLARA_LEAD_DEPARTMENT_ID=
CLARA_BOOKING_CALENDAR_ID=
CLARA_BOOKING_TYPE_ID=
CLARA_BOOKING_TZ=
CLARA_SMS_DAILY_CAP=
CLARA_VOICE_ID=
CLARA_ELEVENLABS_VOICE_ID=
CLARA_TTS_PRONUNCIATIONS=
CLARA_VOICE_DEVICE_KEY=
# Only if Clara's machine sits behind Cloudflare Access
CLARA_CF_ACCESS_CLIENT_ID=
CLARA_CF_ACCESS_CLIENT_SECRET=
# Shared secrets between the agents and Orion (long random strings)
INTERAGENT_SHARED_SECRET=
SUPERVISOR_REPORT_KEY=
OS_SMS_RELAY_SECRET=
# Memory vault sync from the agent machine
VAULT_SYNC_KEY=
VAULT_SYNC_ORG_ID=00000000-0000-0000-0000-000000000001
# Agent health alerts
SYSTEM_HEALTH_AGENTS=
SYSTEM_HEALTH_PING_TIMEOUT_MINUTES=
AGENT_LIVENESS_FROM_NUMBER=
AGENT_LIVENESS_STALE_MINUTES=
AGENT_LIVENESS_RENAG_HOURS=
AGENT_LIVENESS_TOTAL_OUTAGE_RENAG_MINUTES=
AGENT_SCHEDULE_OVERDUE_MINUTES=
AI_USAGE_DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001

# ─── Phone and SMS (Twilio) ───────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# ─── Voice (ElevenLabs) ───────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=

# ─── Google (Gmail, Calendar, Drive) ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_ENCRYPTION_KEY=
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT=
GMAIL_PUBSUB_ENFORCE=

# ─── Microsoft 365 ────────────────────────────────────────────────────────────────────────
MS_FILES_ACCOUNT_EMAIL=

# ─── Payments ─────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SIGNING_SECRET=
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=

# ─── Website, forms and web chat ──────────────────────────────────────────────────────────
SITE_URL=
PUBLIC_SITE_URL=
SITE_WEBHOOK_SECRET=
SITE_LEAD_REPLY_TO=
SITE_LEAD_BRAND=
HCAPTCHA_SECRET=
WEBCHAT_ALLOWED_ORIGINS=
WEBCHAT_SESSION_SECRET=
SCORECARD_ORG_ID=00000000-0000-0000-0000-000000000001
SCORECARD_ACTOR_USER_ID=

# ─── Push notifications (web push VAPID keys) ─────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ─── Government contracts (SAM.gov) ───────────────────────────────────────────────────────
SAM_GOV_API_KEY=

# ─── Maintenance and diagnostics (leave empty unless you need them) ───────────────────────
EMAIL_DIAG_KEY=
SENDGRID_ENCRYPTION_KEY=
# Only used by the bootstrap-admin function; leave empty and sign up normally instead.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
