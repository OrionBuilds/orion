# Env files — never commit secrets; keep the checked-in examples
.env
.env.*
!.env.example

!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Supabase CLI working directory (cache, linked-project metadata,
# transient version pings). The CLI rewrites these on every command.
supabase/.temp/

# Stray 0-byte files produced by shell-quoting accidents (e.g. a bare `0`, `{,`, `false)`).
# They have been committed by mistake more than once; ignore them so it cannot happen again.
# Legitimate root-level files never contain these shell-metacharacters, so this is a safe net.
/*(*
/*)*
/*{*
/*}*
/*;*
